# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-api03-...your-key-here...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Database (read-only user used by the app) ---
DATABASE_URL=postgresql+psycopg2://readonly_user:readonly_pw@db:5432/shop
ADMIN_DATABASE_URL=postgresql+psycopg2://shop_admin:admin_pw@db:5432/shop

# --- POSTGRES init (consumed by docker-compose) ---
POSTGRES_DB=shop
POSTGRES_USER=shop_admin
POSTGRES_PASSWORD=admin_pw

# --- Guardrail config ---
MAX_ROWS=1000
MAX_SUBQUERY_DEPTH=3
MAX_EXPLAIN_ROWS=1000000
QUERY_TIMEOUT_S=10

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Frontend ---
API_BASE_URL=http://localhost:8000
